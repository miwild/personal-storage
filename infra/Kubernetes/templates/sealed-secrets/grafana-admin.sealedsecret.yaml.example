# This file documents the expected SealedSecret structure for Grafana admin
# credentials. It is NOT a deployable manifest — do not apply this directly.
#
# The real SealedSecret is generated at deploy time by the GitHub Actions
# workflow (.github/workflows/observability-deploy.yml) using kubeseal,
# with credentials sourced from GitHub secrets:
#   - GRAFANA_ADMIN_USER (default: admin)
#   - GRAFANA_ADMIN_PASSWORD (randomly generated or set per deployment)
#
# The kubeseal command used at deploy time:
#
#   kubectl create secret generic grafana-admin \
#     --namespace platform-observability \
#     --from-literal=admin-user="$GRAFANA_ADMIN_USER" \
#     --from-literal=admin-password="$GRAFANA_ADMIN_PASSWORD" \
#     --dry-run=client -o yaml \
#     | kubeseal \
#       --controller-namespace default \
#       --format yaml \
#     | kubectl apply -f -
#
# The SealedSecrets controller (deployed in `default` namespace by the
# nextcloud-umbrella chart) creates a plain Kubernetes Secret named
# `grafana-admin` in `platform-observability` with keys `admin-user`
# and `admin-password`, which Grafana references via
# `admin.existingSecret: grafana-admin` in values.yaml.
#
# --- End of documentation ---
# Below is a placeholder showing the expected structure after sealing.
# The encryptedData section would contain the actual sealed key values.
---
# apiVersion: bitnami.com/v1alpha1
# kind: SealedSecret
# metadata:
#   name: grafana-admin
#   namespace: platform-observability
#   annotations:
#     sealedsecrets.bitnami.com/managed: "true"
# spec:
#   encryptedData:
#     admin-user: AgBy3i4 ...  # (sealed, not plaintext)
#     admin-password: AgBy3i4 ...  # (sealed, not plaintext)
#   template:
#     metadata:
#       name: grafana-admin
#       namespace: platform-observability
